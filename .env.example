# Public website origin
NEXT_PUBLIC_SITE_URL=https://zololabssolutions.com

# Optional assistant
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=

# Address displayed beside the contact form
CONTACT_EMAIL=

# Server-only Supabase credentials (do not use NEXT_PUBLIC_ prefixes)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Recommended email notifications. FROM must use a verified Resend domain.
RESEND_API_KEY=
INQUIRY_NOTIFICATION_FROM=
# One address, or a comma-separated list of team addresses
INQUIRY_NOTIFICATION_TO=

# Optional alternative to email: an automation endpoint accepting JSON POST.
# With no Supabase config, this preserves the original webhook-only form behavior.
CONTACT_WEBHOOK_URL=

# Optional retry scheduler authorization (use a long random secret)
CRON_SECRET=
